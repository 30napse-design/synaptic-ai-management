# SYNAPSE configuration NAMES and safe defaults only. No real credentials.
# Reference: docs/independent-runtime-fa.md
# This file is documentation, not a Worker binding configuration.
# Worker env values must be injected by the destination runtime; merely copying
# this to .env does not configure Cloudflare bindings or activate authentication.

# Required server-only auth secret. Supply securely in the destination.
# Existing password hashes AND encrypted initial-password delivery need the same
# pepper; replacing it requires an authorized account/password recovery plan.
STAFF_AUTH_PEPPER=

# Optional server-only key; leave empty with AI disabled.
OPENAI_API_KEY=
SYNAPSE_AI_ENABLED=false
SYNAPSE_AI_PROVIDER=openai
# Select an available provider model only after approval; no implicit default.
SYNAPSE_AI_MODEL=
# Real AI remains unavailable until all of these owner-approved values are set.
SYNAPSE_AI_MAX_OUTPUT_TOKENS=
SYNAPSE_AI_DAILY_REQUESTS=
SYNAPSE_AI_GLOBAL_DAILY_REQUESTS=
SYNAPSE_AI_REQUEST_RESERVE_USD=
SYNAPSE_AI_DAILY_BUDGET_USD=

# Optional privileged import/bootstrap secrets. Keep unset in ordinary operation.
# Legacy four-account setup endpoint; NOT needed to restore the nine accounts.
STAFF_ACCOUNT_SETUP_TOKEN=
# Existing operations import endpoint, x-synapse-ops request header.
STAFF_OPS_SETUP_TOKEN=
# Expiring, exact-body provisioning grant. Never copy live contents into Git.
# JSON fields: id, token_hash, body_hash, expires_at (epoch ms), scope where used.
SYNAPSE_PROVISION_REQUEST=

# DB / BUCKET / CONNECTORS are OBJECT/SERVICE BINDINGS, not text env variables.
# Their interfaces and destination configuration are documented in the guide.

# Optional local tool settings. No credentials and no production behavior change.
CLOUDFLARE_CF_FETCH_ENABLED=false
WRANGLER_SEND_METRICS=false
WRANGLER_WRITE_LOGS=false
# Leave blank/unset to use project-local defaults (do not export empty paths).
# SITES_RUNTIME_ROOT=
# WRANGLER_LOG_PATH=
# WRANGLER_REGISTRY_PATH=
# MINIFLARE_REGISTRY_PATH=
# Optional existing browser-test runtime paths; no package installed by this file.
# PLAYWRIGHT_MODULE=
# CHROMIUM_PATH=
# Optional bounded managed build settings; existing scripts provide defaults.
# SITES_BUILD_TIMEOUT=3m
# SITES_BUILD_KILL_AFTER=10s

# Package 5 — server-only integrations (never put real values in this file).
# AES-GCM encryption of source credentials and model key in existing settings.
# Preserve the same key securely to restore encrypted settings on another host.
SYNAPSE_INTEGRATION_KEY=
# Google Cloud OAuth web client; register the exact callback URL on destination.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional external scheduler's x-synapse-automation credential; unset = closed.
SYNAPSE_AUTOMATION_TOKEN=
# External cron runner only; not a new API credential and not a deployment action.
# HTTPS origin of the authorized deployment; runner is inert until invoked.
SYNAPSE_BASE_URL=
